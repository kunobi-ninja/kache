+/// Section holding the side files that `.oxart` does not carry.
+const SIDE_FILE_SECTION_NAME: &str = ".oxside";
+
+/// Embeds the side files this crate's device codegen left in `output_dir`
+/// (all except the artifact `.oxart` already holds) in a `.oxside` section.
+///
+/// `.oxart` carries only the final artifact, and the runtime loader reads
+/// it, so the side files go in a separate section that nothing loads. A
+/// build that restores rustc's outputs from a cache without running this
+/// backend can then restore these files too (`cargo oxide` does this after
+/// every build). Each record is `u32 name length, name, u64 data length,
+/// data`, little-endian, with no padding.
+fn write_side_file_object(
+    output_dir: &Path,
+    output_name: &str,
+    host_target: &str,
+    embedded_name: &str,
+    artifact_object: &[u8],
+) -> Result<Option<PathBuf>, Box<dyn std::error::Error>> {
+    use object::Object as _;
+
+    let mut section = Vec::new();
