+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+//! Restore device side files from the built binaries and rlibs.
+//!
+//! The backend writes `<crate>.ptx`, `<crate>.ll`, and their siblings while
+//! rustc runs, outside rustc's declared outputs. A compiler cache that
+//! restores those outputs without running rustc skips that write. The same
+//! bytes are embedded in the build (`.oxart` holds the device artifact,
+//! `.oxside` the other side files), so after each successful build we write
+//! them back from there. A file that the build already wrote must match the
+//! embedded copy byte for byte; an older file is stale and gets replaced, as
+//! rustc would have replaced it.
+
+use std::collections::BTreeMap;
+use std::ffi::{OsStr, OsString};
+use std::io::{BufRead, BufReader};
+use std::path::{Path, PathBuf};
+use std::process::{Command, ExitStatus, Stdio};
+use std::time::SystemTime;
+
+use object::{Object, ObjectSection};
+use oxide_artifacts::{ArtifactPayloadKind, OwnedArtifactBundle};
+
+const SIDE_FILE_SECTION_NAME: &str = ".oxside";
+
+/// A binary or rlib that Cargo reports for a path package.
+struct BuiltArtifact {
+    /// Crate name of the target; its side files are named `<crate>.<suffix>`.
+    crate_name: String,
+    manifest_dir: PathBuf,
+    path: PathBuf,
+    is_rlib: bool,
+    /// Cargo reused it without invoking rustc, so no side files were written.
+    fresh: bool,
+}
+
+/// Run the `cargo build` in `cmd`, then restore device side files if it
+/// succeeded.
+///
+/// The backend writes side files into `CUDA_OXIDE_PTX_DIR` when set, and
+/// otherwise into rustc's working directory: `workspace_root` for path
+/// packages under it, the package directory for other path packages.
+pub(super) fn run_cargo_build_restoring_side_files(
+    cmd: &mut Command,
+    workspace_root: &Path,
+) -> ExitStatus {
+    // Cargo still renders diagnostics to stderr; only stdout becomes JSON.
+    cmd.arg("--message-format=json-render-diagnostics")
+        .stdout(Stdio::piped());
+    let started = SystemTime::now();
+    let mut child = cmd.spawn().expect("Failed to run cargo");
+    let stdout = child.stdout.take().expect("cargo stdout is piped");
+    let mut artifacts = Vec::new();
+    for line in BufReader::new(stdout).lines() {
+        let line = line.expect("Failed to read cargo output");
+        match serde_json::from_str::<serde_json::Value>(&line) {
+            Ok(message) => artifacts.extend(built_artifacts(&message)),
+            Err(_) => println!("{line}"),
+        }
+    }
+    let status = child.wait().expect("Failed to run cargo");
+    if status.success() {
+        let ptx_dir = command_env(cmd, "CUDA_OXIDE_PTX_DIR").map(PathBuf::from);
+        if let Err(error) =
+            restore_side_files(&artifacts, workspace_root, ptx_dir.as_deref(), started)
+        {
+            eprintln!("Error: could not restore device side files: {error}");
+            std::process::exit(1);
+        }
+    }
+    status
+}
+
+fn built_artifacts(message: &serde_json::Value) -> Vec<BuiltArtifact> {
+    if message["reason"] != "compiler-artifact"
+        || !message["package_id"]
+            .as_str()
+            .is_some_and(|id| id.starts_with("path+"))
+    {
+        return Vec::new();
+    }
+    let (Some(name), Some(manifest_dir)) = (
+        message["target"]["name"].as_str(),
+        message["manifest_path"]
+            .as_str()
+            .and_then(|path| Path::new(path).parent()),
+    ) else {
+        return Vec::new();
+    };
+    let artifact = |path: &str, is_rlib| BuiltArtifact {
+        crate_name: name.replace('-', "_"),
+        manifest_dir: manifest_dir.to_path_buf(),
+        path: PathBuf::from(path),
+        is_rlib,
+        fresh: message["fresh"] == true,
+    };
+    let rlibs = message["filenames"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|path| path.as_str())
+        .filter(|path| path.ends_with(".rlib"))
+        .map(|path| artifact(path, true));
+    let executable = message["executable"]
+        .as_str()
+        .map(|path| artifact(path, false));
+    rlibs.chain(executable).collect()
+}
+
+fn command_env(cmd: &Command, key: &str) -> Option<OsString> {
+    match cmd.get_envs().find(|(name, _)| *name == OsStr::new(key)) {
+        Some((_, value)) => value.map(OsStr::to_os_string),
+        None => std::env::var_os(key),
+    }
+}
+
+fn restore_side_files(
+    artifacts: &[BuiltArtifact],
+    workspace_root: &Path,
+    ptx_dir: Option<&Path>,
+    started: SystemTime,
+) -> Result<(), String> {
+    let workspace_root = canonical(workspace_root)?;
+    // Restore only what rustc would have written in this build: nothing for
+    // artifacts Cargo reused. Later artifacts win, as a later rustc overwrote
+    // the file. A binary also holds the `.oxart` bundles of the libraries it
+    // links; those came from the rlibs, so skip them rather than let them
+    // shadow its own.
+    let mut files = BTreeMap::<PathBuf, Vec<u8>>::new();
+    let mut library_bundles = Vec::new();
+    for artifact in artifacts {
+        if artifact.fresh && !artifact.is_rlib {
+            continue;
+        }
+        let manifest_dir = canonical(&artifact.manifest_dir)?;
+        let rustc_dir = if manifest_dir.starts_with(&workspace_root) {
+            &workspace_root
+        } else {
+            &manifest_dir
+        };
+        let dir = ptx_dir.map_or_else(|| rustc_dir.clone(), |dir| rustc_dir.join(dir));
+        let embedded = read_embedded(&artifact.path, artifact.is_rlib)?;
+        for bundle in embedded.bundles {
+            if !artifact.is_rlib && library_bundles.contains(&bundle) {
+                continue;
+            }
+            for payload in &bundle.payloads {
+                // The backend writes only PTX and NVVM IR artifacts to disk.
+                if !artifact.fresh
+                    && matches!(
+                        payload.kind,
+                        ArtifactPayloadKind::Ptx | ArtifactPayloadKind::NvvmIr
+                    )
+                    && is_crate_file(&payload.name, &artifact.crate_name)
+                {
+                    files.insert(dir.join(&payload.name), payload.bytes.clone());
+                }
+            }
+            if artifact.is_rlib {
+                library_bundles.push(bundle);
+            }
+        }
+        for (name, bytes) in embedded.side_files {
+            if !artifact.fresh && is_crate_file(&name, &artifact.crate_name) {
+                files.insert(dir.join(name), bytes);
+            }
+        }
+    }
+
+    for (path, bytes) in files {
+        let written_by_this_build = match std::fs::metadata(&path) {
+            Ok(metadata) => metadata
+                .modified()
+                .is_ok_and(|modified| modified >= started),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => false,
+            Err(error) => return Err(format!("could not read {}: {error}", path.display())),
+        };
+        if written_by_this_build {
+            let existing = std::fs::read(&path)
+                .map_err(|error| format!("could not read {}: {error}", path.display()))?;
+            if existing != bytes {
+                return Err(format!(
+                    "{} differs from the copy embedded in the build",
+                    path.display()
+                ));
+            }
+        } else {
+            std::fs::write(&path, &bytes)
+                .map_err(|error| format!("could not write {}: {error}", path.display()))?;
+        }
+    }
+    Ok(())
+}
+
+fn canonical(path: &Path) -> Result<PathBuf, String> {
+    path.canonicalize()
+        .map_err(|error| format!("could not resolve {}: {error}", path.display()))
+}
+
+/// Whether `name` is `<crate_name>.<suffix>`, a file this crate's codegen writes.
+fn is_crate_file(name: &str, crate_name: &str) -> bool {
+    name.strip_prefix(crate_name)
+        .is_some_and(|rest| rest.starts_with('.') && !rest.contains(['/', '\\']))
+}
+
+#[derive(Default)]
+struct Embedded {
+    bundles: Vec<OwnedArtifactBundle>,
+    side_files: Vec<(String, Vec<u8>)>,
+}
+
+/// Read `.oxart` bundles and `.oxside` files from a binary, or from every
+/// object member of an rlib.
+fn read_embedded(path: &Path, is_rlib: bool) -> Result<Embedded, String> {
+    let context = |error: &dyn std::fmt::Display| format!("{}: {error}", path.display());
+    let data = std::fs::read(path).map_err(|error| context(&error))?;
+    let mut embedded = Embedded::default();
+    if !is_rlib {
+        read_object(&data, &mut embedded).map_err(|error| context(&error))?;
+        return Ok(embedded);
+    }
+    let archive =
+        object::read::archive::ArchiveFile::parse(&*data).map_err(|error| context(&error))?;
+    for member in archive.members() {
+        let member_data = member
+            .and_then(|member| member.data(&*data))
+            .map_err(|error| context(&error))?;
+        // Skip members that are not objects; they carry no sections.
+        if object::File::parse(member_data).is_ok() {
+            read_object(member_data, &mut embedded).map_err(|error| context(&error))?;
+        }
+    }
+    Ok(embedded)
+}
+
+fn read_object(data: &[u8], embedded: &mut Embedded) -> Result<(), String> {
+    let file = object::File::parse(data).map_err(|error| error.to_string())?;
+    for section in file.sections() {
+        let name = section.name().map_err(|error| error.to_string())?;
+        if name != oxide_artifacts::ARTIFACT_SECTION_NAME && name != SIDE_FILE_SECTION_NAME {
+            continue;
+        }
+        let bytes = section.data().map_err(|error| error.to_string())?;
+        if name == SIDE_FILE_SECTION_NAME {
+            embedded.side_files.extend(parse_side_file_section(bytes)?);
+        } else {
+            let bundles = oxide_artifacts::parse_artifact_section(bytes)
+                .map_err(|error| error.to_string())?;
+            embedded.bundles.extend(bundles.into_iter().map(Into::into));
+        }
+    }
+    Ok(())
+}
+
+/// Parse the backend's `u32 name length, name, u64 data length, data`
+/// records (little-endian). Trailing zero bytes are linker padding.
+fn parse_side_file_section(mut bytes: &[u8]) -> Result<Vec<(String, Vec<u8>)>, String> {
+    fn take<'a>(bytes: &mut &'a [u8], len: usize) -> Result<&'a [u8], String> {
+        if bytes.len() < len {
+            return Err("truncated .oxside section".to_string());
+        }
+        let (head, tail) = bytes.split_at(len);
+        *bytes = tail;
+        Ok(head)
+    }
+
+    let mut files = Vec::new();
+    while bytes.iter().any(|byte| *byte != 0) {
+        let name_len = u32::from_le_bytes(take(&mut bytes, 4)?.try_into().unwrap());
+        let name = std::str::from_utf8(take(&mut bytes, name_len as usize)?)
+            .map_err(|_| "non-UTF-8 file name in .oxside section".to_string())?
+            .to_string();
+        let data_len = u64::from_le_bytes(take(&mut bytes, 8)?.try_into().unwrap());
+        let data_len = usize::try_from(data_len).map_err(|error| error.to_string())?;
+        files.push((name, take(&mut bytes, data_len)?.to_vec()));
+    }
+    Ok(files)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn side_file_section_round_trips_records_and_ignores_padding() {
+        let mut section = Vec::new();
+        for (name, data) in [("demo.ll", &b"define"[..]), ("demo.opt.ll", &b""[..])] {
+            section.extend_from_slice(&(name.len() as u32).to_le_bytes());
+            section.extend_from_slice(name.as_bytes());
+            section.extend_from_slice(&(data.len() as u64).to_le_bytes());
+            section.extend_from_slice(data);
+        }
+        section.extend_from_slice(&[0; 7]);
+        assert_eq!(
+            parse_side_file_section(&section).unwrap(),
+            vec![
+                ("demo.ll".to_string(), b"define".to_vec()),
+                ("demo.opt.ll".to_string(), Vec::new()),
+            ]
+        );
+        assert!(parse_side_file_section(&section[..10]).is_err());
+    }
+
+    #[test]
+    fn only_files_named_after_the_crate_are_restored() {
+        assert!(is_crate_file("vecadd.ptx", "vecadd"));
+        assert!(is_crate_file("vecadd.linked.opt.ll", "vecadd"));
+        assert!(!is_crate_file("vecadd_lib.ptx", "vecadd"));
+        assert!(!is_crate_file("vecadd", "vecadd"));
+        assert!(!is_crate_file("vecadd./../x.ptx", "vecadd"));
+    }
+}
