+/// Suffixes of the files device codegen writes next to its artifact.
+const SIDE_FILE_SUFFIXES: &[&str] = &[
+    "ll",
+    "linked.ll",
+    "opt.ll",
+    "linked.opt.ll",
+    "options",
+    "target",
+];
